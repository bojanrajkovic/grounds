{
  "name": "grounds-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "docs:generate-api": "typedoc",
    "docs:build-validator": "./mdbook/build-validator.sh",
    "docs:build": "pnpm build && pnpm docs:generate-api && pnpm docs:build-validator && mdbook build mdbook",
    "docs:serve": "mdbook serve mdbook",
    "prepare": "husky",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@commitlint/cli": "20.4.4",
    "@commitlint/config-conventional": "20.4.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/conventional-commits-parser": "5.0.2",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.0",
    "conventional-commits-parser": "6.3.0",
    "husky": "9.1.7",
    "knip": "5.86.0",
    "lint-staged": "16.3.3",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "tsx": "4.21.0",
    "typedoc": "0.28.17",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "packageManager": "pnpm@10.32.1"
}
