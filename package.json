{
  "name": "grounds-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "docs:generate-api": "typedoc",
    "docs:build-validator": "./mdbook/build-validator.sh",
    "docs:build": "pnpm build && pnpm docs:generate-api && pnpm docs:build-validator && mdbook build mdbook",
    "docs:serve": "mdbook serve mdbook",
    "prepare": "husky",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/conventional-commits-parser": "5.0.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "conventional-commits-parser": "7.1.2",
    "husky": "9.1.7",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tsx": "4.23.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
